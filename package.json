{
  "name": "auto-tester",
  "version": "1.0.0",
  "description": "Automated testing platform for web apps — slow API detection & feature testing",
  "main": "dist/cli/index.js",
  "bin": {
    "auto-tester": "./dist/cli/index.js"
  },
  "scripts": {
    "test": "playwright test",
    "test:site": "playwright test --project",
    "build": "tsc",
    "build:server": "cd dashboard/server && npx tsc",
    "dev": "ts-node cli/index.ts",
    "run:site": "ts-node cli/index.ts run --site",
    "run:all": "ts-node cli/index.ts run --all",
    "codegen": "playwright codegen",
    "dashboard": "bash scripts/start.sh",
    "test:cli": "bash scripts/test.sh"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "js-yaml": "^4.1.0",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.2"
  }
}
