# ─── Target website ────────────────────────────────────────────────────────────
BASE_URL=https://yourapp.com

# ─── Login credentials ─────────────────────────────────────────────────────────
TEST_EMAIL=user@example.com
TEST_PASSWORD=secret

# ─── Login page config ────────────────────────────────────────────────────────
LOGIN_PATH=/login
EMAIL_SELECTOR=[name="email"]
PASSWORD_SELECTOR=[name="password"]
SUBMIT_SELECTOR=button[type="submit"]

# ─── Performance thresholds ────────────────────────────────────────────────────
# Any API response slower than this (ms) will be flagged
SLOW_API_THRESHOLD_MS=2000

# ─── PostgreSQL (dashboard) ────────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGUSER=admin
PGPASSWORD=
PGDATABASE=auto_tester

# ─── Telegram notifications (optional) ─────────────────────────────────────────
# Leave empty to disable Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
